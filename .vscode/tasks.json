{
    // Задачи сборки и развёртывания проекта IED-Template.
    // Локальная отладка:  "Build (host x86_64)"  -> build/ied_exe
    // Плата PC 2 (aarch64): "Build (target orangepi-pc2)" + "Deploy & gdbserver (orangepi-pc2)" -> 192.168.100.52
    // Плата One  (arm32):   "Build (target orangepi-one)" + "Deploy & gdbserver (orangepi-one)" -> 192.168.100.51
    // SDK: распакуйте нужный *_sdk-buildroot.tar.gz из репозитория iedos,
    // выполните relocate-sdk.sh и экспортируйте IEDOS_SDK (см. README).
    // Флаги configure находятся в CMakePresets.json: задачи вызывают
    // "cmake --preset <имя>", там же их можно менять.
    "version": "2.0.0",
    "tasks": [
        {
            // Сборка под локальный хост (x86_64) с отладочной информацией (-g).
            // Это задача по умолчанию: F7 / Ctrl+Shift+B.
            "label": "Build (host x86_64)",
            "type": "shell",
            "command": "cmake --preset host && cmake --build --preset host -j",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "CMake configure + build для локальной отладки (x86_64, Debug)"
        },
        {
            // Кросс-сборка под Orange Pi PC 2 (aarch64, H5).
            "label": "Build (target orangepi-pc2)",
            "type": "shell",
            "command": "cmake --preset orangepi-pc2 && cmake --build --preset orangepi-pc2 -j",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Кросс-компиляция под aarch64 (IEDOS SDK, $IEDOS_SDK), Debug"
        },
        {
            // Кросс-сборка под Orange Pi One (arm 32-bit, H3).
            "label": "Build (target orangepi-one)",
            "type": "shell",
            "command": "cmake --preset orangepi-one && cmake --build --preset orangepi-one -j",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Кросс-компиляция под arm-linux-gnueabihf (IEDOS SDK, $IEDOS_SDK), Debug"
        },
        {
            // Загрузка бинарника на Orange Pi PC 2 и запуск gdbserver.
            "label": "Deploy & gdbserver (orangepi-pc2)",
            "type": "shell",
            "command": "scp build-aarch64/ied_exe root@192.168.100.52:/root/ && ssh root@192.168.100.52 \"pkill -f 'gdbserver 0.0.0.0:1234' ; nohup gdbserver 0.0.0.0:1234 /root/ied_exe eth0 >/tmp/gdbserver.log 2>&1 & sleep 1; echo 'gdbserver started on 192.168.100.52:1234'",
            "problemMatcher": [],
            "detail": "scp бинарника на плату PC 2 + запуск gdbserver :1234"
        },
        {
            // Загрузка бинарника на Orange Pi One и запуск gdbserver.
            "label": "Deploy & gdbserver (orangepi-one)",
            "type": "shell",
            "command": "scp build-arm/ied_exe root@192.168.100.51:/root/ && ssh root@192.168.100.51 \"pkill -f 'gdbserver 0.0.0.0:1234' ; nohup gdbserver 0.0.0.0:1234 /root/ied_exe eth0 >/tmp/gdbserver.log 2>&1 & sleep 1; echo 'gdbserver started on 192.168.100.51:1234'",
            "problemMatcher": [],
            "detail": "scp бинарника на плату One + запуск gdbserver :1234"
        },
        {
            // Проверка aarch64-бинарника БЕЗ реального железа: QEMU user-mode под кросс-gdb.
            // Запускается в терминале — управляйте классическими командами gdb (b, c, n, s, p).
            // Требуется qemu-user на хосте (apt install qemu-user).
            "label": "QEMU + cross-gdb (terminal)",
            "type": "shell",
            "command": "${env:IEDOS_SDK}/bin/aarch64-buildroot-linux-gnu-gdb -ex \"target remote | qemu-aarch64 -L ${env:IEDOS_SDK}/aarch64-buildroot-linux-gnu/sysroot -g stdio ./build-aarch64/ied_exe eth0\"",
            "problemMatcher": [],
            "detail": "Эмуляция build-aarch64/ied_exe в QEMU под aarch64-gdb (нужна кросс-сборка)"
        }
    ]
}
